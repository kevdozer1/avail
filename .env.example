# Copy to .env and fill in. .env is gitignored.
#
# Every key is optional. Without keys AVAIL runs its free checks: probes, passive signals and classical vision.
# A key is needed only for VLM judges, through OpenRouter. Set a credit limit on the key as a hard backstop.
OPENROUTER_API_KEY=

# Where data goes: zoo tables, ledgers, videos. A relative path is read from the repo folder.
AVAIL_DATA=avail_data

# Hardware gate. Leave empty: nothing in this release moves a real robot.
AVAIL_ALLOW_HARDWARE=
